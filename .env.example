# TrustLens Global Environment Example
# Backend Settings
DATABASE_URL=sqlite:///./trustlens.db
# For PostgreSQL: postgresql://user:password@localhost:5432/trustlens_db
SECRET_KEY=trustlens-super-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_ANALYZE=20/minute

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
